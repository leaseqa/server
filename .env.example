PORT=<server-port>
CLIENT_URL=<client-origin>
CORS_ALLOWED_ORIGINS=<comma-separated-client-origins>
# Migration: CLIENT_URLS is deprecated; use CORS_ALLOWED_ORIGINS for additional origins.
SERVER_URL=<public-server-url>
SERVER_ENV=<development-or-production>
UPLOADS_ENABLED=<true-or-false>
UPLOADS_DIR=<absolute-persistent-upload-directory>
DATABASE_CONNECTION_STRING=<mongodb-connection-string>
SESSION_SECRET=<random-session-secret>
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_CALLBACK_URL=<google-oauth-callback-url>
DEMO_PASSWORD=<demo-user-password>
CI_DISABLE_RATE_LIMIT=<true-or-false>

# The corpus is committed in this repository at
# `resources/rag-corpus/mass tenant rights` and is resolved from the repository
# checkout first, then from parent directories. Leave RAG_CORPUS_ROOT unset for
# local development and CI; set it only to override that for another layout, such
# as a mounted volume or a separate corpus checkout.
RAG_CORPUS_ROOT=<optional-rag-corpus-directory-override>
RAG_CORPUS_MANIFEST=<rag-corpus-manifest-path>
RAG_INGEST_STATE_PATH=<rag-ingest-state-path>
RAG_EVAL_BASE_URL=<rag-evaluation-base-url>
RAG_MILVUS_ADDRESS=<milvus-host-and-port>
RAG_MILVUS_TOKEN=<milvus-token>
RAG_MILVUS_KNOWLEDGE_COLLECTION=<milvus-knowledge-collection>
RAG_MILVUS_SESSION_COLLECTION=<milvus-session-collection>
# `RAG_PROVIDER=zhipu` is what this project runs on: Zhipu BigModel
# (`https://open.bigmodel.cn/api/paas/v4`), glm-5.3-flash chat and embedding-3
# embedding at 1024-d. Put the key in `ZHIPU_API_KEY`; its format is
# `<32 hex>.<16 chars>`. `RAG_PROVIDER=ark` (Volcengine Ark Agent Plan, a paid
# subscription that lapsed on 2026-10-06) and `RAG_PROVIDER=dashscope`
# (Alibaba DashScope / 百炼) remain available.
#
# ALWAYS SET THIS EXPLICITLY. Left unset, the provider is inferred from the
# base URLs and falls back to dashscope, so supplying only ARK_API_KEY gets
# you the DashScope preset and its models.
#
# Both plugs speak the OpenAI-compatible interface; per-field RAG_CHAT_* /
# RAG_EMBEDDING_* overrides can point at any OpenAI-compatible endpoint.
# Ark chat models: doubao-seed-2.0-lite (default), doubao-seed-2.0-mini,
# doubao-seed-2.0-pro. Put the ark- UUID in `ARK_API_KEY`; it is not a model.
#
# Leave the RAG_CHAT_* / RAG_EMBEDDING_* overrides unset unless you mean them:
# they win over the preset, so an Ark URL left behind after a switch sends
# BigModel requests to Ark.
#
# Switching embedding vendor or dimension requires a new knowledge ingest
# (versioned alias) and a new session collection. A dimension change is caught
# by Milvus, but every provider here embeds at 1024-d, so switching between
# them without re-ingesting fails SILENTLY: the query vector
# lands in the wrong space, scores drop under RAG_MIN_SUPPORT_SCORE, and the
# answer becomes an unexplained abstention. Keep readers and the last ingest
# on the same provider.
RAG_PROVIDER=<zhipu-ark-or-dashscope>
ZHIPU_API_KEY=<zhipu-bigmodel-api-key>
ARK_API_KEY=<volcengine-ark-agent-plan-api-key>
DASHSCOPE_API_KEY=<dashscope-api-key>
RAG_CHAT_API_KEY=<rag-chat-api-key-or-reuse-provider-key>
RAG_CHAT_MODEL=<unset-to-use-the-preset-default>
RAG_CHAT_BASE_URL=<https://ark.cn-beijing.volces.com/api/plan/v3-or-https://dashscope.aliyuncs.com/compatible-mode/v1>
RAG_EMBEDDING_API_KEY=<rag-embedding-api-key-or-reuse-provider-key>
RAG_EMBEDDING_MODEL=<unset-to-use-the-preset-default>
RAG_EMBEDDING_BASE_URL=<https://ark.cn-beijing.volces.com/api/plan/v3-or-https://dashscope.aliyuncs.com/compatible-mode/v1>
RAG_EMBEDDING_DIMENSIONS=<1024>
RAG_EMBEDDING_DIMENSION=<alias-of-RAG_EMBEDDING_DIMENSIONS>
RAG_EMBEDDING_PROVIDER=<legacy-openai-alias-of-RAG_PROVIDER>
RAG_EMBEDDING_TIMEOUT_MS=<embedding-timeout-ms-default-15000>
RAG_CHAT_TIMEOUT_MS=<chat-timeout-ms-default-45000>
RAG_VECTOR_TIMEOUT_MS=<vector-timeout-ms-default-10000>
RAG_CHUNK_SIZE=<rag-chunk-size>
RAG_CHUNK_OVERLAP=<rag-chunk-overlap>
RAG_KNOWLEDGE_TOP_K=<rag-knowledge-top-k>
RAG_SESSION_TOP_K=<rag-session-top-k>
RAG_MIN_SUPPORT_SCORE=<0-1-relevance-floor-for-abstention-default-0.025>
RAG_UPLOAD_MAX_BYTES=<rag-upload-max-bytes>
RAG_HISTORY_MESSAGES=<rag-history-message-count>
# Retrieval gate that must pass before the knowledge alias is repointed.
# Set to "off" to skip it (not recommended outside local experiments).
RAG_INGEST_GATE=on
RAG_INGEST_GATE_MIN_HIT_RATE=0.9
